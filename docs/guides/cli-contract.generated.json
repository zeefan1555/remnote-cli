                  "answer": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 10000
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "remId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 256,
                                    "pattern": "\\S"
                                  }
                                },
                                "required": [
                                  "remId"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          },
                          {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 10000
                              },
                              "language": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_+#.-]{1,64}$"
                              }
                            },
                            "required": [
                              "code"
                            ],
                            "additionalProperties": false
