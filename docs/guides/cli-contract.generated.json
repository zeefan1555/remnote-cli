                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 10000
                            },
                            "language": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_+#.-]{1,64}$"
                            }
                          },
                          "required": [
                            "code"
