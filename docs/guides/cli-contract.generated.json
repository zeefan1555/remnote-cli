                "additionalProperties": false
              }
            },
            "answerPatches": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "cardRemId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  },
                  "remId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  },
                  "expectedTextHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "text": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 10000
                            },
                            {
                              "type": "object",
                              "properties": {
                                "remId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 256,
                                  "pattern": "\\S"
                                }
                              },
                              "required": [
                                "remId"
                              ],
                              "additionalProperties": false
                            }
